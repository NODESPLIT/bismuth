[ > ]
( Any, Any ) :{ return Value::Make(left->compare(right, Value::Comparison::Greater)); }:

[ >= ]
( Any, Any ) :{ return Value::Make(left->compare(right, Value::Comparison::GreaterOrEqual)); }:

[ < ]
( Any, Any ) :{ return Value::Make(left->compare(right, Value::Comparison::Lesser)); }:

[ <= ]
( Any, Any ) :{ return Value::Make(left->compare(right, Value::Comparison::LesserOrEqual)); }:

[ == ]
( Any, Any ) :{ return Value::Make(left->equals(right)); }:

[ != ]
( Any, Any ) :{ return Value::Make(!left->equals(right)); }: